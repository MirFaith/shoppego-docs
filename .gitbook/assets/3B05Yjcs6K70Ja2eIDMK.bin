                box-sizing: border-box;
            }
            *:focus, *:hover {
                outline: none;
            }
            .gitbook-root, .gitbook-splashscreen { position: fixed; top:0; right: 0; bottom: 0; left: 0; display:flex; width: 100%; height:100%; }
