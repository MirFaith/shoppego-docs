                height: 0;
                color: transparent;
                outline: none;
                position: absolute;
            }
            @keyframes LoadingIndicator {
                from { transform: rotate(0deg); }
                to { transform: rotate(360deg); }
            }
            [data-loading-indicator="true"] {
                animation: LoadingIndicator 0.6s ease infinite;
            }
